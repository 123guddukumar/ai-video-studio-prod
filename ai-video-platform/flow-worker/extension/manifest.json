{
  "manifest_version": 3,
  "name": "Google Flow Automation Helper",
  "version": "1.0.0",
  "description": "Automates Google Flow image/video generation under your active session and connects to the local flow-worker.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "scripting",
    "debugger"
  ],

  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": ["injector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
