# ============================================================
# AI Video Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- Application -----
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://videogen:videogen@postgres:5432/videogendb
DATABASE_URL_SYNC=postgresql://videogen:videogen@postgres:5432/videogendb

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- Storage (local filesystem — no S3 needed) -----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage/projects
# Publicly accessible base URL for assets served by backend
STORAGE_PUBLIC_URL=http://localhost:8000/storage

# ----- Groq API (Script Generation) -----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_MAX_RETRIES=3

# ----- ElevenLabs (Voice Generation) -----
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# ----- Flow Worker (Google Flow / Veo) -----
FLOW_WORKER_URL=http://flow-worker:8001
FLOW_CHROMIUM_PROFILE_PATH=/app/chrome-profile
FLOW_GOOGLE_FLOW_URL=https://labs.google/fx/tools/flow
FLOW_TIMEOUT_SECONDS=300
FLOW_MAX_RETRIES=3

# ----- Video Worker (FFmpeg) -----
VIDEO_WORKER_URL=http://video-worker:8002
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
OUTPUT_RESOLUTION=1920x1080
OUTPUT_FPS=30
OUTPUT_VIDEO_CODEC=libx264
OUTPUT_AUDIO_CODEC=aac

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
